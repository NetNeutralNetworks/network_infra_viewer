<doc>
##################################################################################################
TTP Template to parse Cisco IOS "show running config" and extract all basic system information.
##################################################################################################

```
snmp-server ifindex persist
snmp-server ifmib stats cache
!!!!!!!!!!!!!!!!!!!!!!!!!!!! Two SNMP servers - same 2 IP's on every device !!!!
snmp-server host 145.50.42.31 traps xxxxxxxx
snmp-server host 145.50.42.159 traps xxxxxxxx
snmp-server community xxxxxx RO IPv4 8
snmp-server community xxxxxxxx RO IPv4 10
snmp-server community xxxxxxxx RW IPv4 11
snmp-server queue-length 200
snmp-server traps rf
snmp-server traps bfd
snmp-server traps ntp
snmp-server traps copy-complete
snmp-server traps snmp linkup
snmp-server traps snmp linkdown
snmp-server traps snmp coldstart
snmp-server traps snmp warmstart
snmp-server traps snmp authentication
snmp-server traps flash removal
snmp-server traps flash insertion
snmp-server traps config
snmp-server traps entity
snmp-server traps system
snmp-server traps entity-state operstatus
snmp-server traps entity-state switchover
snmp-server contact did-nnv-beheer@rws.nl
snmp-server location 437 - RWS ZH Verkeers Management Centrale (VMC-ZWN), Rhoon
snmp-server trap-source Loopback1
```
</doc>

<group name='root._snmp**'>
snmp-server contact {{contact | ORPHRASE}}
</group>

<group name='root._snmp**'>
snmp-server location {{location | ORPHRASE}}
</group>

<group name='root._snmp**'>
snmp-server trap-source {{source_interface}}
</group>

<group name='root._snmp**'>
snmp-server queue-length {{queue_length | to_int}}
</group>

<group name='root._snmp**'>
snmp-server system-shutdown {{system_shutdown| set(True) | default(False)}}
</group>

<group name='root._snmp**'>
snmp-server ifindex persist {{ifindex_persist| set(True) | default(False)}}
</group>

<group name='root._snmp**' >
snmp-server ifmib stats cache {{ifmib_stats_cache| set(True) | default(False)}}
</group>

<group name='root._snmp**.hosts.{{host}}' method="table">
snmp-server host {{host}} {{community}}
snmp-server host {{host}} traps {{community}}
</group>

<group name='root._snmp.communities*' method="table">
snmp-server community {{name}} {{access_type}} IPv4 {{acl}}
</group>

<group name='root._snmp.traps**.{{service}}*' method="table" itemize="items">
snmp-server traps {{service | let('items', '')}}
snmp-server traps {{service}} {{ items | ORPHRASE}}
</group>
